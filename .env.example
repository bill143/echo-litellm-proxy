# ============================================================================
# ECHO — environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is git-ignored and must NEVER be committed. This file documents the
# variable NAMES the stack requires — placeholder values only, no secrets.
# ============================================================================

# ── LiteLLM proxy ───────────────────────────────────────────────────────────
# Master key clients present as `Authorization: Bearer <key>`. Must start "sk-".
LITELLM_MASTER_KEY=sk-replace-me

# ── Upstream provider API keys (referenced by litellm_config.yaml) ───────────
ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-replace-me
GOOGLE_AI_API_KEY=replace-me
DEEPSEEK_API_KEY=sk-replace-me
XAI_API_KEY=xai-replace-me

# ── Spare / rotation keys (optional, not referenced by the active config) ────
ANTHROPIC_API_KEY_2=sk-ant-replace-me
OPENAI_API_KEY_2=sk-replace-me
GOOGLE_AI_API_KEY_2=replace-me
MOONSHOT_API_KEY=sk-replace-me
ELEVENLABS_API_KEY=replace-me

# ── Langfuse → LiteLLM observability credentials ─────────────────────────────
# Project keys Langfuse issues (auto-provisioned via LANGFUSE_INIT_* below for
# local dev). The ECHO container reads these to authenticate the langfuse
# callback. LANGFUSE_HOST is set to the in-network service by docker-compose.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_HOST=http://langfuse:3000

# ── Langfuse server config ───────────────────────────────────────────────────
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
SALT=replace-me-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32   # exactly 64 hex chars
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=replace-me

# ── Postgres (Langfuse backing store) ────────────────────────────────────────
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=replace-me
LANGFUSE_DB_NAME=langfuse
